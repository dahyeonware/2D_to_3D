PORT=3000
DB_PATH=./data/ktx.db
UPLOAD_DIR=./data/uploads
DEMO_MODE=1            # 1이면 데모 시나리오·고장 시뮬레이션 버튼 표시
SESSION_SECRET=change-me

# --- 배포(Vercel + Supabase)용: 로컬에서는 비워 두면 SQLite 사용 ---
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
# ADMIN_KEY=        # 설정하면 쓰기 API에 X-Admin-Key 헤더 필요
# REALTIME=sse      # sse | poll (Vercel에서는 자동으로 poll)
