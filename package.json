{
  "name": "ktx-equipment-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "KTX 장비 위치·연결 관계 시각화 웹앱 (로컬 구동 + SQLite, 가상 데이터)",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["server", "web"],
  "scripts": {
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-reset.js",
    "db:check": "node scripts/check-integrity.js",
    "db:backup": "node scripts/db-backup.js",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm -w server run dev\" \"npm -w web run dev\"",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "test": "npm -w server run test && npx playwright test",
    "test:api": "npm -w server run test",
    "test:e2e": "npx playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
